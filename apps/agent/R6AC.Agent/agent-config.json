{
  "version": "1.0.0",
  "apiBaseUrl": "https://api.r6ac.ir",
  "scanIntervalSeconds": 5,
  "reportSyncIntervalSeconds": 30,
  "offlineMode": true,
  "language": "fa",
  "detection": {
    "processDetection": true,
    "windowDetection": true,
    "usbDetection": true,
    "networkDetection": true,
    "driverDetection": true,
    "behavioralDetection": true,
    "gameIntegrityCheck": true,
    "selfIntegrityCheck": true
  },
