# Database
DATABASE_URL=postgresql://r6ac:password@localhost:5432/r6ac
TEST_DATABASE_URL=postgresql://r6ac:password@localhost:5432/r6ac_test

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_this_to_a_random_256bit_secret
JWT_REFRESH_SECRET=change_this_to_another_random_256bit_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=3001
NODE_ENV=production
HOST=0.0.0.0

# CORS
CORS_ORIGIN=https://r6ac.ir

# API
API_VERSION=v1
API_BASE_URL=https://api.r6ac.ir

# ArvanCloud Storage (optional)
ARVAN_ACCESS_KEY=
ARVAN_SECRET_KEY=
ARVAN_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ARVAN_BUCKET=r6ac-evidence

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
